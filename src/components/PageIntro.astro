---
import type { IntroPanelContent } from "../i18n/types";

interface Props {
  intro: IntroPanelContent;
}

const { intro } = Astro.props;
const showInlineTags = intro.tags && intro.tags.length > 0 && intro.tagPlacement === "inline";
const showSideTags = intro.tags && intro.tags.length > 0 && intro.tagPlacement !== "inline";
---

<section class="section page-intro-section">
  <div class="container">
    <div class="page-intro-card surface-card">
      <div>
        <p class="eyebrow">{intro.eyebrow}</p>
        <h1>{intro.title}</h1>
        <p class="lede">{intro.description}</p>

        {showInlineTags && (
          <div class="tag-row intro-tag-row">
            {intro.tags!.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}

        {intro.links && intro.links.length > 0 && (
          <div class="button-row intro-actions">
            {intro.links.map((link, index) => (
              <a
                class:list={["button", index === 0 ? "primary" : "secondary"]}
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="page-intro-side">
        {intro.stats && intro.stats.length > 0 && (
          <div class="surface-card intro-panel">
            <ul class="meta-list">
              {intro.stats.map((stat) => (
                <li>
                  <strong>{stat.label}</strong>
                  <span>{stat.value}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {showSideTags && (
          <div class="surface-card intro-panel">
            <div class="tag-row">
              {intro.tags!.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .intro-actions {
    margin-top: 1.3rem;
  }

  .intro-tag-row {
    margin-top: 1.2rem;
    gap: 0.6rem;
  }

  .intro-panel {
    padding: 1.15rem;
    border-radius: var(--radius-md);
    background: rgba(247, 249, 252, 0.88);
    box-shadow: none;
  }

  .intro-panel .tag-row {
    gap: 0.55rem;
  }
</style>
