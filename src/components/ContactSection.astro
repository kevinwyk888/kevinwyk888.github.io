---
import type { ContactSectionContent } from "../i18n/types";

interface Props {
  section: ContactSectionContent;
}

const { section } = Astro.props;
---

<section class="section" id={section.id}>
  <div class="container">
    <div class="section-heading">
      <div>
        <h2>{section.title}</h2>
        <p class="lede">{section.intro}</p>
      </div>
    </div>

    <div class="contact-grid">
      {section.channels.map((channel) => (
        <a class="surface-card contact-card" href={channel.href} target={channel.href.startsWith("http") ? "_blank" : undefined} rel={channel.href.startsWith("http") ? "noreferrer" : undefined}>
          <span class="contact-label">{channel.label}</span>
          <strong>{channel.value}</strong>
          <span class="contact-note">{channel.note}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-card {
    display: grid;
    gap: 0.4rem;
    padding: 1.35rem;
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 75, 123, 0.24);
  }

  .contact-label {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card strong {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .contact-note {
    color: var(--muted);
    font-size: 0.94rem;
  }

  @media (max-width: 1020px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
