---
import type { EducationSectionContent } from "../i18n/types";

interface Props {
  section: EducationSectionContent;
}

const { section } = Astro.props;
---

<section class="section education-section" id={section.id}>
  <div class="container">
    <div class="section-heading">
      <div>
        <h2>{section.title}</h2>
        <p class="lede">{section.intro}</p>
      </div>
    </div>

    <div class="education-grid">
      {section.items.map((item) => (
        <article class="surface-card education-card">
          <div class="education-logo">
            <img src={item.logo} alt={item.logoAlt} loading="lazy" />
          </div>

          <div class="education-copy">
            <div class="education-topline">
              <span class="education-degree">{item.degree}</span>
              <span class="education-dates">{item.dates}</span>
            </div>
            <h3>{item.institution}</h3>
            <p class="education-meta">
              <span>{item.location}</span>
              {item.gpa && <span>{item.gpa}</span>}
            </p>

            <ul>
              {item.description.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .education-card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
  }

  .education-logo {
    display: inline-flex;
    width: 5rem;
    height: 5rem;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(22, 52, 86, 0.08);
    background: #fff;
  }

  .education-topline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
  }

  .education-degree {
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .education-dates {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .education-copy h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }

  .education-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-weight: 600;
  }

  .education-copy ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text);
  }

  @media (max-width: 1020px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
